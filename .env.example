# TMDB — free registration at https://www.themoviedb.org/settings/api
# Supplies people, credits, billing order, runtime, budget and revenue.
# Either credential works. The v4 read access token (a long eyJ... string) is
# preferred and used when present; the v3 key is the fallback.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# OMDb — http://www.omdbapi.com/apikey.aspx
# Free tier is capped at 1,000 calls/day; $1+/month Patreon lifts it.
# Supplies IMDb rating and votes, Metascore, and the RT Tomatometer.
OMDB_API_KEY=
